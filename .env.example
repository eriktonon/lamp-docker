TZ=America/Sao_Paulo
HTTP_PORT=8080
MYSQL_PORT=3306
PMA_PORT=8081

# MySQL 8.4 LTS Credentials (Local Dev Baseline)
MYSQL_ROOT_PASSWORD=local_root_dev_only
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=local_user_dev_only
